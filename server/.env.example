# Copy to server/.env and fill in the required values:  cp .env.example .env
# Real environment variables (e.g. on Render) take priority over this file,
# so deploys don't need a .env at all.

# --- Required — the app refuses to boot without these ---

# Async Postgres connection string (the +asyncpg part picks the async driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/care_infrastructure

# Signs every JWT — any random long string works locally. Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string

# Sends summary emails — get a free key at https://resend.com. Required:
# a blank key would boot fine but fail every send with a confusing 502.
RESEND_API_KEY=

# --- Optional — defaults shown, only set to override ---

# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080

# The From address on summary emails ("Name <address>"). The default is
# Resend's sandbox sender, which only DELIVERS TO OUR OWN account email —
# fine locally. Production sets an address on the domain verified at
# https://resend.com/domains so emails reach real recipients.
# EMAIL_SENDER=J.W.T <onboarding@resend.dev>

# --- Optional until the AI-draft feature needs it in prod ---

# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# Speech-to-text for iOS / browsers without the Web Speech API. Blank is fine
# (that transcription route 502s and the frontend falls back to typing).
# Get a free key at https://deepgram.com
DEEPGRAM_API_KEY=
